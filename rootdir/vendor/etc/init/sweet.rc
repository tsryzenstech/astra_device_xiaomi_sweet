# Xiaomi Redmi Note 10 Pro (sweet) - device specific boot actions

# Before all the drivers, in this order, as tested on the phone:
#  - The watchdog's driver. The bootloader leaves the hardware watchdog running,
#    and without it the phone freezes at about 30 s and resets at about 50 s.
#  - The panel a second time, hidden by the brightness. With all the drivers
#    loaded this modeset freezes the phone, so it comes first. It may not be
#    needed now that the next step exists: not tested without it yet.
#  - Two DSC slices per packet, as Xiaomi's panel settings have it (slice-per-pkt).
#    The kernel's DSI driver can only send one, and then the panel stays black or
#    shows garbage. DSI_VIDEO_COMPRESSION_MODE_CTRL: WC 540 -> 1080, PKT_PER_LINE
#    2 -> 1. A modeset to another rate would put it back: only 120 Hz is offered.
#  - The logo, at once: the panel scans the framebuffer out continuously.
on hardware-init
    exec -- /system/bin/modprobe qcom_wdt
    write /sys/class/backlight/ae94000.dsi.0/brightness 0
    exec -- /system/bin/disptest reinit
    exec -- /system/bin/disptest setreg 0xae942a0 0x021c0b41 0x04380b01
    write /sys/class/backlight/ae94000.dsi.0/brightness 1024
    start bootanim

on early-init
    # Firmware for the Adreno GPU, DSPs and modem lives in /vendor/firmware.
    write /sys/module/firmware_class/parameters/path /vendor/firmware

on boot
    # Kryo 470: 6x little (policy0) + 2x big (policy6) cores.
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_governor schedutil
    # UFS: avoid the block layer reordering small random writes.
    write /sys/block/sda/queue/scheduler none
    # DRM display and render nodes permissions
    chmod 0666 /dev/dri/card0
    chmod 0666 /dev/dri/card1
    chmod 0666 /dev/dri/renderD128
    chown system graphics /dev/dri/card0
    chown system graphics /dev/dri/card1
    chown system graphics /dev/dri/renderD128
    # Backlight and panel power
    chmod 0664 /sys/class/backlight/*/brightness
    chmod 0664 /sys/class/backlight/*/bl_power
    chown system system /sys/class/backlight/*/brightness
    chown system system /sys/class/backlight/*/bl_power
    write /sys/class/backlight/*/bl_power 0
