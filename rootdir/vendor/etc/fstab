# Xiaomi Redmi Note 10 Pro (sweet) - astraOS fstab
#
# Logical partitions live in "super" and are mapped by the first stage init
# (ramdisk). userdata is formatted as ext4 on first boot when it is blank
# ("formattable" never touches a partition that already has a filesystem).
#
# <src>                        <mnt>      <type>  <mount flags>                     <fs_mgr flags>
system                         /          ext4    ro,noatime                        wait,logical,first_stage_mount
vendor                         /vendor    ext4    ro,noatime                        wait,logical,first_stage_mount
product                        /product   ext4    ro,noatime                        wait,logical,first_stage_mount
/dev/block/by-name/userdata    /data      ext4    noatime,nosuid,nodev,discard      wait,formattable
