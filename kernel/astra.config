# astraOS kernel configuration fragment for SM7150 (merged on top of
# "defconfig sm7150.config" from the sm7150-mainline kernel).
CONFIG_LOCALVERSION="-astra"

# First stage init: storage, device mapper and filesystems must be built in
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=n
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_ZERO=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_RD_GZIP=y
CONFIG_BLK_DEV_INITRD=y

# Display, GPU and input for SysBoard (eglfs on KMS, libinput)
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_SAMSUNG_AMS667YR01=y
CONFIG_TOUCHSCREEN_GOODIX_GTX8=y
CONFIG_INPUT_EVDEV=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Firmware is loaded directly by the kernel (no user space helper)
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Radios
CONFIG_RFKILL=y
CONFIG_QRTR=y

# Misc
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PSI=y
CONFIG_ZRAM=m

# Boot console on the screen through the bootloader's framebuffer
# (simple-framebuffer node), before the MSM display driver takes over.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=n
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# Keep the last kernel log and init's errors across a reboot
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# USB device mode: rescue serial console (first stage) and ADU networking
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_GADGET=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_EEM=y

# Buttons: power and volume down on the PMIC, volume up on a GPIO
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_MISC=y

# Wi-Fi (WCN3990 via ath10k), Bluetooth (QCA UART) and the modem
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=m
CONFIG_BT_QCA=m
CONFIG_QRTR_SMD=m
CONFIG_QCOM_RMTFS_MEM=m
CONFIG_QCOM_Q6V5_MSS=m
CONFIG_QCOM_PD_MAPPER=m
