# astraOS kernel configuration fragment for SM7150 (merged on top of
# "defconfig sm7150.config" from the sm7150-mainline kernel).
CONFIG_LOCALVERSION="-astra"

# First stage init: storage, device mapper and filesystems must be built in
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=n
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_ZERO=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_RD_GZIP=y
CONFIG_BLK_DEV_INITRD=y

# Display, GPU and input for SysBoard (eglfs on KMS, libinput)
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_SAMSUNG_AMS667YR01=y
CONFIG_TOUCHSCREEN_GOODIX_GTX8=y
CONFIG_INPUT_EVDEV=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Firmware is loaded directly by the kernel (no user space helper)
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Radios
CONFIG_RFKILL=y
CONFIG_QRTR=y

# Misc
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PSI=y
CONFIG_ZRAM=m
