// astraOS boot logo for Plymouth: the logo on black, half the screen wide
// (as /system/media/bootanimation/desc.txt), fading in, then breathing
// slowly until SysBoard takes over the screen. Messages and prompts are not
// shown: the boot is quiet.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo.image = Image("logo.png");
scale = Window.GetWidth() * 0.5 / logo.image.GetWidth();
logo.image = logo.image.Scale(logo.image.GetWidth() * scale, logo.image.GetHeight() * scale);
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetOpacity(0);

frame = 0;
fun refresh_callback() {
    frame++;
    if (frame < 25) {
        logo.sprite.SetOpacity(frame / 25);
    } else {
        logo.sprite.SetOpacity(0.8 + 0.2 * Math.Cos((frame - 25) / 30));
    }
}
Plymouth.SetRefreshFunction(refresh_callback);
