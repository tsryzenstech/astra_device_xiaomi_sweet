#!/sbin/openrc-run
# SPDX-License-Identifier: Apache-2.0
# astraOS on postmarketOS: astraOS's init runs as a service supervisor
# (init --supervisor) and starts astrad and SysBoard from their .rc files.
# postmarketOS's own init (OpenRC) keeps the kernel, devices, mounts, D-Bus,
# Wi-Fi, Bluetooth and the modem.

name="astraOS"
description="astraOS system services and SysBoard"

command="/system/bin/init"
command_args="--supervisor $ASTRA_RC"
command_background="yes"
pidfile="/run/astraos.pid"
output_log="/var/log/astraos.log"
error_log="/var/log/astraos.log"
retry="TERM/10/KILL/2"

# Only localmount is required: a missing optional service must not keep the
# phone from showing astraOS. The boot logo (Plymouth, from the initramfs)
# stays up until astraOS starts: before kill-plymouth, which would remove it
# earlier.
depend() {
	need localmount
	want dbus udev-settle iwd bluetooth modemmanager
	after udev udev-settle rmtfs pd-mapper tqftpserv
	before kill-plymouth
}

start_pre() {
	checkpath -d -m 0755 /dev/socket
	checkpath -d -m 0771 /data
	# SysBoard needs the display (DRM master): Plymouth lets go of it,
	# leaving the logo on screen until SysBoard's first frame (which shows
	# the same logo while the shell loads).
	if command -v plymouth >/dev/null && plymouth --ping 2>/dev/null; then
		plymouth quit --retain-splash
		local i=0
		while plymouth --ping 2>/dev/null && [ $i -lt 30 ]; do
			sleep 0.1
			i=$((i + 1))
		done
	fi
	# Tools astraOS runs as /system/bin/<name>.
	local tool path
	for tool in sh udevadm mke2fs mkfs.f2fs; do
		path=$(command -v "$tool") || continue
		[ -e "/system/bin/$tool" ] || ln -s "$path" "/system/bin/$tool"
	done
	export TZ="${TZ:-UTC}"
}
